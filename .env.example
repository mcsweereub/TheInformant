# Free key: https://developer.company-information.service.gov.uk/ (create an application, then a REST API key)
COMPANIES_HOUSE_API_KEY=

# Companies House depth: full (accounts, share capital, charges, ownership, related
# companies) or basic (core data only).
# INFORMANT_REGISTRY=full
# Read figures from PDF-only accounts (annual report, else OCR of the scan; needs an LLM).
# INFORMANT_PDF_ACCOUNTS=on
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # if not found automatically

# LLM used to extract summary, sectors, products and offices from website text.
# Easiest: run `uv run informant model` and pick from the list (it writes these for you).
# INFORMANT_LLM=ollama            # ollama (free, local) | claude (paid) | auto
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=16384
# OLLAMA_NUM_PREDICT=4096         # most output tokens per call (stops runaway answers)
# Claude: key from https://platform.claude.com/
ANTHROPIC_API_KEY=
# INFORMANT_MODEL=claude-opus-5-5
# INFORMANT_EFFORT=low
# How text is sent to the LLM: auto | single (one call) | staged (parts, then a merge).
# INFORMANT_LLM_STRATEGY=auto
# INFORMANT_STAGE_CHARS=9000      # size of each part in staged mode
# INFORMANT_MAX_STAGES=5          # most parts per company in staged mode

# Local cache of crawled pages and LLM answers (see README).
# INFORMANT_CACHE=on              # off to disable
# INFORMANT_CACHE_DIR=.informant_cache
# INFORMANT_CACHE_DAYS=7          # how long crawled pages are reused
# INFORMANT_HISTORY=on            # keep a dated copy of each lookup (change tracking)

# Look in the site's sitemap for key pages the homepage doesn't link: on | off.
# INFORMANT_SITEMAP=on

# Refuse requests to private/local addresses (this computer, the home network), even
# when a site links or redirects there: on | off.
# INFORMANT_NETGUARD=on

# Headless browser for JavaScript-built websites: auto (only when needed), always, never.
# Needs: uv run playwright install chromium
# INFORMANT_BROWSER=auto

# News: on | off, and how many days back to search.
# INFORMANT_NEWS=on
# INFORMANT_NEWS_DAYS=90

# Web search (Tavily; free key at https://tavily.com, about 1,000 searches a month).
# Used for mentions and to find a missing website or annual report.
TAVILY_API_KEY=
# INFORMANT_SEARCH=on
# INFORMANT_SEARCH_MAX=4          # most real searches per lookup (cached repeats are free)

# Free public-data sources to leave out (comma-separated, or "all"):
# gleif, contracts, donations, property, jobs, feeds, domain
# INFORMANT_SKIP=

# Property owned (HM Land Registry companies dataset). Free account + licence at
# https://use-land-property-data.service.gov.uk/ ; then `uv run informant property --update`.
LAND_REGISTRY_API_KEY=
# INFORMANT_DATA_DIR=.informant_data   # where downloaded datasets are kept

# Optional: adds the Guardian's archive. Free key: https://open-platform.theguardian.com/
# GUARDIAN_API_KEY=

# Optional: enables Wikipedia/Wikidata (company facts, and finding the website).
# Wikimedia requires contact details (an email or URL) in the User-Agent and blocks
# requests without them; this value is sent to Wikimedia only.
# INFORMANT_CONTACT=
# INFORMANT_WIKIPEDIA=on
