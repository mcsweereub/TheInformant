# Free key: https://developer.company-information.service.gov.uk/ (create an application, then a REST API key)
COMPANIES_HOUSE_API_KEY=

# LLM used to extract summary, sectors, products and offices from website text.
# Easiest: run `uv run informant model` and pick from the list (it writes these for you).
# INFORMANT_LLM=ollama            # ollama (free, local) | claude (paid) | auto
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=16384
# Claude: key from https://platform.claude.com/
ANTHROPIC_API_KEY=
# INFORMANT_MODEL=claude-opus-5-5
# INFORMANT_EFFORT=low
# How text is sent to the LLM: auto | single (one call) | staged (parts, then a merge).
# INFORMANT_LLM_STRATEGY=auto
# INFORMANT_STAGE_CHARS=9000      # size of each part in staged mode
# INFORMANT_MAX_STAGES=5          # most parts per company in staged mode

# Local cache of crawled pages and LLM answers (see README).
# INFORMANT_CACHE=on              # off to disable
# INFORMANT_CACHE_DIR=.informant_cache
# INFORMANT_CACHE_DAYS=7          # how long crawled pages are reused

# Headless browser for JavaScript-built websites: auto (only when needed), always, never.
# Needs: uv run playwright install chromium
# INFORMANT_BROWSER=auto

# Optional: enables Wikidata website lookups. Wikimedia requires contact details
# (an email or URL) in the User-Agent and blocks requests without them.
# INFORMANT_CONTACT=
